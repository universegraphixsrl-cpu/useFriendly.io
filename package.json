{
  "name": "magic-patterns-vite-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "npx vite preview",
    "smoke": "npx esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --define:import.meta.env='{\"VITE_SUPABASE_URL\":\"https://smoke.supabase.co\",\"VITE_SUPABASE_ANON_KEY\":\"smoke-key\",\"DEV\":false,\"PROD\":true}' --outfile=node_modules/.cache/smoke-real.cjs && node node_modules/.cache/smoke-real.cjs",
    "smoke:demo": "npx esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --define:import.meta.env='{\"DEV\":true,\"PROD\":false}' --outfile=node_modules/.cache/smoke-demo.cjs && node node_modules/.cache/smoke-demo.cjs",
    "checks": "npx esbuild scripts/checks.ts --bundle --platform=node --format=cjs --jsx=automatic --define:import.meta.env='{\"DEV\":true,\"PROD\":false}' --outfile=node_modules/.cache/checks.cjs && node node_modules/.cache/checks.cjs",
    "verify": "npm run build && npm run checks && npm run smoke && npm run smoke:demo"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.0.0",
    "html2canvas": "latest",
    "jspdf": "^2.5.1",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.2.0"
  }
}
